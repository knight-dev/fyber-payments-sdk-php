{
    "name": "fyber/slim-checkout-example",
    "description": "Fyber PHP SDK - Slim Framework checkout example",
    "type": "project",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "slim/twig-view": "^3.4",
        "fyber/sdk-php": "dev-main",
        "vlucas/phpdotenv": "^5.5",
        "php-di/php-di": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": "php -S localhost:8080 -t public"
    }
}
