{% extends "layout.twig" %}

{% block content %}
<div class="flex justify-between items-center mb-4">
    <h1>Webhook Events</h1>
    <span class="badge badge-info">{{ events|length }} event(s)</span>
</div>

<div class="card">
    <h3 class="card-title">Webhook Endpoint</h3>
    <p class="text-muted mb-4">
        Configure your Fyber dashboard to send webhooks to:
    </p>
    <code style="display: block; background: var(--gray-100); padding: 1rem; border-radius: 0.375rem;">
        POST {{ url_for('request').schemeAndHttpHost }}/webhooks
    </code>
</div>

{% if events|length == 0 %}
<div class="card text-center" style="padding: 3rem;">
    <p class="text-muted">No webhook events received yet.</p>
    <p class="text-muted" style="font-size: 0.875rem;">
        Make a payment to trigger webhook events.
    </p>
    <a href="/checkout" class="btn btn-primary mt-4">Make a Payment</a>
</div>
{% else %}
<div class="card">
    <h3 class="card-title">Recent Events</h3>
    <table>
        <thead>
            <tr>
                <th>Time</th>
                <th>Type</th>
                <th>ID</th>
                <th>Details</th>
            </tr>
        </thead>
        <tbody>
            {% for event in events %}
            <tr>
                <td class="text-muted" style="font-size: 0.875rem;">
                    {{ event.received_at ?? event.created|date('Y-m-d H:i:s') }}
                </td>
                <td>
                    {% set typeClass = 'info' %}
                    {% if 'completed' in event.type %}
                        {% set typeClass = 'success' %}
                    {% elseif 'failed' in event.type %}
                        {% set typeClass = 'danger' %}
                    {% elseif 'created' in event.type %}
                        {% set typeClass = 'warning' %}
                    {% endif %}
                    <span class="badge badge-{{ typeClass }}">{{ event.type }}</span>
                </td>
                <td style="font-size: 0.875rem;">
                    <code>{{ event.id ?? 'N/A' }}</code>
                </td>
                <td style="font-size: 0.875rem;">
                    {% if event.data.object.id is defined %}
                        Object: <code>{{ event.data.object.id }}</code>
                    {% endif %}
                    {% if event.data.object.amount is defined %}
                        | ${{ '%.2f'|format(event.data.object.amount / 100) }}
                    {% endif %}
                    {% if event.error is defined %}
                        <span class="text-muted">{{ event.error }}</span>
                    {% endif %}
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}

<div class="card">
    <h3 class="card-title">Supported Event Types</h3>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.5rem;">
        <div><code>payment.created</code></div>
        <div><code>payment.completed</code></div>
        <div><code>payment.failed</code></div>
        <div><code>refund.created</code></div>
        <div><code>refund.completed</code></div>
        <div><code>customer.created</code></div>
        <div><code>customer.updated</code></div>
        <div><code>customer.deleted</code></div>
    </div>
</div>
{% endblock %}
