{% extends "layout.twig" %}

{% block content %}
<div style="max-width: 600px; margin: 0 auto; text-align: center;">
    <div class="card" style="padding: 3rem;">
        <div style="width: 80px; height: 80px; background: #fef3c7; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#f59e0b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
        </div>

        <h1 style="font-size: 1.75rem; margin-bottom: 0.5rem;">Something Went Wrong</h1>

        {% if error %}
        <div class="alert alert-danger" style="text-align: left;">
            {{ error }}
        </div>
        {% endif %}

        <a href="/" class="btn btn-secondary">Back to Home</a>
    </div>
</div>
{% endblock %}
