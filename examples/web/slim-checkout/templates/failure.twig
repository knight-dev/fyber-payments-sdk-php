{% extends "layout.twig" %}

{% block content %}
<div style="max-width: 600px; margin: 0 auto; text-align: center;">
    <div class="card" style="padding: 3rem;">
        <div style="width: 80px; height: 80px; background: #fee2e2; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem;">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#ef4444" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"></line>
                <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
        </div>

        <h1 style="font-size: 1.75rem; margin-bottom: 0.5rem; color: #991b1b;">Payment Failed</h1>
        <p class="text-muted" style="margin-bottom: 1.5rem;">We couldn't process your payment.</p>

        {% if error %}
        <div class="alert alert-danger" style="text-align: left;">
            <strong>Error:</strong> {{ error }}
        </div>
        {% endif %}

        <div class="flex gap-2 justify-center">
            <a href="/checkout" class="btn btn-primary">Try Again</a>
            <a href="/" class="btn btn-secondary">Back to Home</a>
        </div>
    </div>
</div>
{% endblock %}
