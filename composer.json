{
    "name": "fyber/sdk-php",
    "description": "Official PHP SDK for Fyber Payment API",
    "type": "library",
    "license": "MIT",
    "keywords": ["fyber", "payments", "sdk", "api", "jamaica", "caribbean"],
    "homepage": "https://docs.fyber.one",
    "authors": [
        {
            "name": "Fyber",
            "email": "support@fyber.one",
            "homepage": "https://fyber.one"
        }
    ],
    "support": {
        "issues": "https://github.com/fyber-payments/sdk-php/issues",
        "source": "https://github.com/fyber-payments/sdk-php"
    },
    "require": {
        "php": "^8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Fyber\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fyber\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
