{% extends "layout.twig" %}

{% block content %}
<div class="flex justify-between items-center mb-4">
    <h1>Customers</h1>
    <a href="/customers/new" class="btn btn-primary">New Customer</a>
</div>

{% if error %}
<div class="alert alert-danger">{{ error }}</div>
{% endif %}

{% if customers|length == 0 %}
<div class="card text-center" style="padding: 3rem;">
    <p class="text-muted">No customers found.</p>
    <a href="/customers/new" class="btn btn-primary mt-4">Create First Customer</a>
</div>
{% else %}
<div class="card">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Email</th>
                <th>Name</th>
                <th>Created</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            {% for customer in customers %}
            <tr>
                <td><code>{{ customer.id }}</code></td>
                <td>{{ customer.email }}</td>
                <td>{{ customer.name ?? '-' }}</td>
                <td class="text-muted">
                    {% if customer.createdAt %}
                        {{ customer.createdAt|date('Y-m-d') }}
                    {% else %}
                        -
                    {% endif %}
                </td>
                <td>
                    <a href="/customers/{{ customer.id }}" class="btn btn-secondary" style="padding: 0.375rem 0.75rem; font-size: 0.875rem;">
                        View
                    </a>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
</div>
{% endif %}
{% endblock %}
